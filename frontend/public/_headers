# Cloudflare Pages Headers Configuration

# index.html - 永遠不快取，每次都向伺服器確認
/index.html
  Cache-Control: no-cache
  Pragma: no-cache
  Expires: 0

# version.json - 永遠不快取，用於版本檢查
/version.json
  Cache-Control: no-cache
  Pragma: no-cache
  Expires: 0

# 靜態資源 (JS/CSS/Images) - Vite 已加 hash，可長時間快取
/assets/*
  Cache-Control: public, max-age=31536000, immutable
